// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  scheduled
  live
  played
  canceled
}

enum MatchEventType {
  goal
  own_goal
  yellow_card
  red_card
  substitution
  note
}

enum MatchCallupStatus {
  pending
  confirmed
  unavailable
}

enum FinancialTransactionType {
  income
  expense
}

enum TrainingSessionStatus {
  scheduled
  completed
  canceled
}

enum AttendanceStatus {
  going
  not_going
  unknown
}

enum InjuryStatus {
  active
  recovered
}

enum PaymentStatus {
  paid
  pending
  overdue
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  clubs                 Club[]
  leagues               League[]
  teams                 Team[]
  players               Player[]
  matches               Match[]
  matchEvents           MatchEvent[]
  matchCallups          MatchCallup[]
  financialTransactions FinancialTransaction[]
  playerPayments        PlayerPayment[]
  trainingSessions      TrainingSession[]
  trainingAttendances   TrainingAttendance[]
  injuryReports         InjuryReport[]
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  name        String?
  role        String   @default("user")
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, role])
}

model Club {
  id               String   @id @default(cuid())
  name             String
  municipalityName String?
  companyId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leagues League[]
  teams   Team[]
  players Player[]
  financialTransactions FinancialTransaction[]
  playerPayments        PlayerPayment[]
  trainingSessions      TrainingSession[]
  injuryReports         InjuryReport[]

  @@index([companyId])
  @@index([companyId, name])
}

model League {
  id        String   @id @default(cuid())
  name      String
  season    String?
  companyId String
  clubId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)
  teams   Team[]
  matches Match[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([clubId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  category  String?
  companyId String
  clubId    String
  leagueId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  league  League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  players Player[]
  homeMatches Match[] @relation("HomeTeamMatches")
  awayMatches Match[] @relation("AwayTeamMatches")
  matchEvents MatchEvent[]
  trainingSessions TrainingSession[]
  injuryReports InjuryReport[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([leagueId])
}

model Player {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  dni       String?
  position  String?
  birthDate DateTime?
  active    Boolean   @default(true)
  companyId String
  clubId    String
  teamId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  matchEvents MatchEvent[]
  playerPayments PlayerPayment[]
  trainingAttendances TrainingAttendance[]
  injuryReports InjuryReport[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([teamId])
  @@unique([companyId, dni])
}

model Match {
  id          String      @id @default(cuid())
  companyId   String
  leagueId    String
  homeTeamId  String
  awayTeamId  String
  scheduledAt DateTime
  status      MatchStatus @default(scheduled)
  homeScore   Int         @default(0)
  awayScore   Int         @default(0)
  venue       String?
  busDepartureTime String?
  jersey      String?
  callupsPublishedAt DateTime?
  lineupSubmittedAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  league    League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam  Team    @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam  Team    @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Cascade)
  events    MatchEvent[]
  callups   MatchCallup[]

  @@index([companyId])
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([companyId, status])
}

model MatchCallup {
  id               String           @id @default(cuid())
  companyId        String
  matchId          String
  playerExternalId String
  playerName       String
  playerPhoto      String?
  status           MatchCallupStatus @default(pending)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerExternalId])
  @@index([companyId])
  @@index([matchId])
  @@index([playerExternalId])
  @@index([companyId, playerExternalId])
  @@index([companyId, publishedAt])
}

model MatchEvent {
  id         String         @id @default(cuid())
  companyId  String
  matchId    String
  teamId     String?
  playerId   String?
  minute     Int?
  type       MatchEventType
  note       String?
  createdAt  DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player  Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
}

model FinancialTransaction {
  id          String                   @id @default(cuid())
  companyId   String
  clubId      String?
  type        FinancialTransactionType
  category    String
  amount      Decimal                  @db.Decimal(12, 2)
  currency    String                   @default("ARS")
  occurredAt  DateTime
  description String?
  reference   String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, type])
  @@index([companyId, occurredAt])
}

model PlayerPayment {
  id            String        @id @default(cuid())
  companyId     String
  clubId        String
  playerId      String
  month         Int
  year          Int
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  paymentMethod String?
  paymentDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([playerId])
  @@index([companyId, clubId])
  @@index([companyId, playerId])
  @@index([companyId, status])
  @@unique([playerId, month, year])
}

model TrainingSession {
  id          String                @id @default(cuid())
  companyId   String
  clubId      String
  teamId      String?
  title       String
  scheduledAt DateTime
  status      TrainingSessionStatus @default(scheduled)
  location    String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team        Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  attendances TrainingAttendance[]

  @@index([companyId])
  @@index([clubId])
  @@index([teamId])
  @@index([scheduledAt])
  @@index([companyId, scheduledAt])
}

model TrainingAttendance {
  id         String           @id @default(cuid())
  companyId  String
  sessionId  String
  playerId   String
  status     AttendanceStatus @default(unknown)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([companyId])
  @@index([sessionId])
  @@index([playerId])
  @@index([companyId, status])
}

model InjuryReport {
  id          String       @id @default(cuid())
  companyId   String
  clubId      String
  teamId      String?
  playerId    String
  description String
  status      InjuryStatus @default(active)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([teamId])
  @@index([playerId])
  @@index([companyId, status])
}
