// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  scheduled
  live
  played
  canceled
}

enum MatchEventType {
  goal
  own_goal
  yellow_card
  red_card
  substitution
  note
}

enum MatchCallupStatus {
  pending
  confirmed
  unavailable
}

enum FinancialTransactionType {
  income
  expense
}

enum TrainingSessionStatus {
  scheduled
  completed
  canceled
}

enum AttendanceStatus {
  going
  not_going
  unknown
}

enum InjuryStatus {
  active
  recovered
}

enum PaymentStatus {
  paid
  pending
  overdue
}

enum ShopOrderStatus {
  pending
  preparing
  ready
  delivered
  cancelled
}

enum ClubMembershipStatus {
  SOLICITADA
  ACTIVA
  RECHAZADA
  BAJA
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipalities        Municipality[]
  users                 User[]
  clubMemberships       ClubMembership[]
  clubs                 Club[]
  leagues               League[]
  teams                 Team[]
  players               Player[]
  members               Member[]
  matches               Match[]
  matchEvents           MatchEvent[]
  matchCallups          MatchCallup[]
  financialTransactions FinancialTransaction[]
  playerPayments        PlayerPayment[]
  shopProducts          ShopProduct[]
  shopOrders            ShopOrder[]
  facilities            Facility[]
  facilityRentals       FacilityRental[]
  clubActivities        ClubActivity[]
  clubTournaments       ClubTournament[]
  trainingSessions      TrainingSession[]
  trainingAttendances   TrainingAttendance[]
  injuryReports         InjuryReport[]
  membershipPlans       MembershipPlan[]
}

model Municipality {
  id        String   @id @default(cuid())
  name      String
  address   String?
  centerLat Float?
  centerLng Float?
  status    String?  @default("active")
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clubs   Club[]
  leagues League[]

  @@index([companyId])
  @@index([companyId, name])
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  name        String?
  role        String   @default("user")
  // null = usuario libre (registrado desde la app pública, sin empresa).
  companyId   String?
  // Perfil del usuario libre (lo completa desde la app pública).
  phone       String?
  city        String?
  sports      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clubMemberships ClubMembership[]
  bookings        Booking[]
  activityInquiries ActivityInquiry[]
  tournamentEntries TournamentEntry[]

  @@index([companyId])
  @@index([companyId, role])
}

model Club {
  id               String   @id @default(cuid())
  name             String
  legalName        String?
  cuit             String?
  foundationDate   DateTime?
  leagueId         String?
  municipalityId   String?
  municipalityName String?
  address          String?
  city             String?
  phone            String?
  email            String?
  billingEmail     String?
  website          String?
  instagram        String?
  facebook         String?
  logoUrl          String?
  // Foto de portada de la ficha pública (Storage del club, https).
  coverUrl         String?
  description      String?
  sport            String?
  status           String?
  // Vidriera pública: ubicación y qué secciones se muestran a usuarios libres.
  latitude         Float?
  longitude        Float?
  isPublic         Boolean  @default(false)
  publicFacilities Boolean  @default(false)
  publicSchools    Boolean  @default(false)
  publicCoaches    Boolean  @default(false)
  publicShop       Boolean  @default(false)
  // Reservas online: zona horaria de los turnos y % de seña sobre el precio.
  timezone         String   @default("America/Argentina/Buenos_Aires")
  depositPercent   Int      @default(30)
  // Reservas desde la app: off | request (sin seña, confirma el club) | deposit (seña por Mercado Pago).
  bookingMode      String   @default("off")
  // Servicios del club (catálogo src/clubs/club-amenities.ts): wifi, vestuarios, duchas…
  amenities        String[] @default([])
  companyId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  league       League?       @relation("LeagueClubs", fields: [leagueId], references: [id], onDelete: SetNull)
  primaryLeagues League[]    @relation("ClubPrimaryLeague")
  teams        Team[]
  players      Player[]
  members      Member[]
  memberships  ClubMembership[]
  financialTransactions FinancialTransaction[]
  playerPayments        PlayerPayment[]
  shopProducts          ShopProduct[]
  shopOrders            ShopOrder[]
  facilities            Facility[]
  facilityRentals       FacilityRental[]
  trainingSessions      TrainingSession[]
  injuryReports         InjuryReport[]
  membershipPlans       MembershipPlan[]
  bookings              Booking[]
  paymentAccount        ClubPaymentAccount?
  activities            ClubActivity[]
  activityInquiries     ActivityInquiry[]
  tournaments           ClubTournament[]
  platformCharges       PlatformCharge[]
  subscription          ClubSubscription?
  subscriptionInvoices  SubscriptionInvoice[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([leagueId])
  @@index([municipalityId])
  @@index([isPublic])
}

model ClubMembership {
  id        String               @id @default(cuid())
  userId    String
  companyId String
  clubId    String
  status    ClubMembershipStatus @default(SOLICITADA)
  role      String
  // Solicitud iniciada por el usuario libre y su revisión por el club.
  message          String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  // Ficha existente del padrón vinculada al aprobar (evita duplicados).
  playerId  String?
  memberId  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player  Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([userId, clubId])
  @@index([companyId, clubId, status])
  @@index([userId, status])
  @@index([playerId])
  @@index([memberId])
}

model League {
  id        String   @id @default(cuid())
  name      String
  season    String?
  companyId String
  clubId    String?
  municipalityId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club         Club?         @relation("ClubPrimaryLeague", fields: [clubId], references: [id], onDelete: SetNull)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  clubs        Club[]        @relation("LeagueClubs")
  teams        Team[]
  matches      Match[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([clubId])
  @@index([municipalityId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  category  String?
  companyId String
  clubId    String
  leagueId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  league  League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  players Player[]
  homeMatches Match[] @relation("HomeTeamMatches")
  awayMatches Match[] @relation("AwayTeamMatches")
  matchEvents MatchEvent[]
  trainingSessions TrainingSession[]
  injuryReports InjuryReport[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([leagueId])
}

model Player {
  id                 String    @id @default(cuid())
  authUid            String?   @unique
  email              String?   @unique
  photoUrl           String?
  firstName          String
  lastName           String
  dni                String?
  position           String?
  birthDate          DateTime?
  phone              String?
  address            String?
  locality           String?
  province           String?
  active             Boolean   @default(true)
  companyId          String
  clubId             String
  teamId             String?
  // Membership
  membershipTier     String?
  membershipCategory String?
  membershipPlanId   String?
  isFamilyPlan       Boolean   @default(false)
  parking            Boolean   @default(false)
  paymentMethod      String?
  notes              String?
  facilitiesAccess   Json?
  extrasAccess       Json?
  familyMembers      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club           Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  membershipPlan MembershipPlan?  @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  matchEvents         MatchEvent[]
  playerPayments      PlayerPayment[]
  trainingAttendances TrainingAttendance[]
  injuryReports       InjuryReport[]
  clubMemberships     ClubMembership[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([authUid])
  @@index([teamId])
  @@index([membershipPlanId])
  @@unique([companyId, dni])
}

model Member {
  id                 String    @id @default(cuid())
  authUid            String?   @unique
  email              String?   @unique
  photoUrl           String?
  firstName          String
  lastName           String
  dni                String?
  birthDate          DateTime?
  phone              String?
  address            String?
  locality           String?
  province           String?
  isFan              Boolean   @default(false)
  active             Boolean   @default(true)
  status             String?   @default("active")
  companyId          String
  clubId             String
  // Membership
  membershipNumber   String?
  membershipTier     String?
  membershipCategory String?
  membershipPlanId   String?
  isFamilyPlan       Boolean   @default(false)
  parking            Boolean   @default(false)
  paymentMethod      String?
  notes              String?
  facilitiesAccess   Json?
  extrasAccess       Json?
  familyMembers      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club           Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  membershipPlan MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  clubMemberships ClubMembership[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([authUid])
  @@index([membershipPlanId])
  @@index([isFan])
  @@unique([companyId, dni])
}

model Match {
  id          String      @id @default(cuid())
  companyId   String
  leagueId    String
  homeTeamId  String
  awayTeamId  String
  scheduledAt DateTime
  status      MatchStatus @default(scheduled)
  homeScore   Int         @default(0)
  awayScore   Int         @default(0)
  venue       String?
  busDepartureTime String?
  jersey      String?
  callupsPublishedAt DateTime?
  lineupSubmittedAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  league    League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam  Team    @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam  Team    @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Cascade)
  events    MatchEvent[]
  callups   MatchCallup[]

  @@index([companyId])
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([companyId, status])
}

model MatchCallup {
  id               String           @id @default(cuid())
  companyId        String
  matchId          String
  playerExternalId String
  playerName       String
  playerPhoto      String?
  status           MatchCallupStatus @default(pending)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerExternalId])
  @@index([companyId])
  @@index([matchId])
  @@index([playerExternalId])
  @@index([companyId, playerExternalId])
  @@index([companyId, publishedAt])
}

model MatchEvent {
  id         String         @id @default(cuid())
  companyId  String
  matchId    String
  teamId     String?
  playerId   String?
  minute     Int?
  type       MatchEventType
  note       String?
  createdAt  DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player  Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
}

model FinancialTransaction {
  id          String                   @id @default(cuid())
  companyId   String
  clubId      String?
  type        FinancialTransactionType
  category    String
  amount      Decimal                  @db.Decimal(12, 2)
  currency    String                   @default("ARS")
  occurredAt  DateTime
  description String?
  reference   String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, type])
  @@index([companyId, occurredAt])
}

model PlayerPayment {
  id            String        @id @default(cuid())
  companyId     String
  clubId        String
  playerId      String
  month         Int
  year          Int
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  paymentMethod String?
  paymentDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([playerId])
  @@index([companyId, clubId])
  @@index([companyId, playerId])
  @@index([companyId, status])
  @@unique([playerId, month, year])
}

model ShopProduct {
  id          String   @id @default(cuid())
  companyId   String
  clubId      String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  category    String
  images      Json?
  sizes       Json?
  sports      Json?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  orders  ShopOrder[]

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, clubId])
}

model ShopOrder {
  id                 String          @id @default(cuid())
  companyId          String
  clubId             String
  customerExternalId String
  customerName       String
  productId          String?
  productName        String
  productImage       String?
  size               String?
  price              Decimal         @db.Decimal(12, 2)
  status             ShopOrderStatus @default(pending)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  product ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([productId])
  @@index([customerExternalId])
  @@index([companyId, clubId])
  @@index([companyId, customerExternalId])
  @@index([companyId, status])
}

model Facility {
  id           String   @id @default(cuid())
  companyId    String
  clubId       String
  name         String
  type         String
  typeLabel    String?
  // Deporte de la cancha (catálogo src/facilities/facility-sports.ts), para filtros.
  sport        String?
  status       String
  statusLabel  String?
  photoUrl     String?
  // Galería pública (hasta 12 URLs https); photoUrl es la portada.
  photos       String[] @default([])
  address      String?
  neighborhood String?
  surfaceType  String?
  services     Json?
  capacity     Json?
  meta         Json?
  // Reservas online desde la app pública.
  bookable     Boolean  @default(false)
  hourlyPrice  Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rentals  FacilityRental[]
  bookings Booking[]

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, clubId])
  @@index([sport])
}

model FacilityRental {
  id          String   @id @default(cuid())
  companyId   String
  clubId      String
  facilityId  String
  clientName  String
  clientPhone String?
  status      String   @default("confirmed")
  isRecurrent Boolean  @default(false)
  day         String
  hour        Int
  price       Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([facilityId])
  @@index([companyId, clubId])
  @@index([companyId, facilityId])
  @@index([companyId, day, hour])
}

model TrainingSession {
  id          String                @id @default(cuid())
  companyId   String
  clubId      String
  teamId      String?
  title       String
  scheduledAt DateTime
  status      TrainingSessionStatus @default(scheduled)
  location    String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team        Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  attendances TrainingAttendance[]

  @@index([companyId])
  @@index([clubId])
  @@index([teamId])
  @@index([scheduledAt])
  @@index([companyId, scheduledAt])
}

model TrainingAttendance {
  id         String           @id @default(cuid())
  companyId  String
  sessionId  String
  playerId   String
  status     AttendanceStatus @default(unknown)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([companyId])
  @@index([sessionId])
  @@index([playerId])
  @@index([companyId, status])
}

model InjuryReport {
  id          String       @id @default(cuid())
  companyId   String
  clubId      String
  teamId      String?
  playerId    String
  description String
  status      InjuryStatus @default(active)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([teamId])
  @@index([playerId])
  @@index([companyId, status])
}

model MembershipPlan {
  id                String   @id @default(cuid())
  companyId         String
  clubId            String
  name              String
  description       String?
  price             Decimal  @default(0) @db.Decimal(12, 2)
  parkingPrice      Decimal  @default(0) @db.Decimal(12, 2)
  familyMemberPrice Decimal  @default(0) @db.Decimal(12, 2)
  facilities        Json?
  extras            Json?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  players Player[]
  members Member[]

  @@index([companyId])
  @@index([clubId])
}

enum BookingStatus {
  REQUESTED // solicitud sin seña: turno retenido hasta que el club confirme o rechace
  PENDING_PAYMENT // turno retenido mientras se paga la seña
  CONFIRMED // seña aprobada por Mercado Pago
  EXPIRED // no se pagó a tiempo; el turno se liberó
  CANCELLED_BY_USER
  CANCELLED_BY_CLUB
}

/// Reserva de un turno (fecha + hora) hecha desde la app pública.
/// Un índice único parcial (en la migración) impide dos reservas activas
/// (PENDING_PAYMENT o CONFIRMED) en la misma cancha, fecha y hora.
model Booking {
  id            String        @id @default(cuid())
  companyId     String
  clubId        String
  facilityId    String
  userId        String
  /// Fecha local del club (YYYY-MM-DD) y hora de inicio (0-23).
  date          String
  hour          Int
  startsAt      DateTime
  status        BookingStatus @default(PENDING_PAYMENT)
  currency      String        @default("ARS")
  price         Decimal       @db.Decimal(12, 2)
  depositAmount Decimal       @db.Decimal(12, 2)
  holdExpiresAt DateTime
  contactName   String?
  contactPhone  String?
  // Mercado Pago
  mpPreferenceId  String?
  mpPaymentId     String?
  mpPaymentStatus String?
  paidAt          DateTime?
  refundedAt      DateTime?
  cancelReason    String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, clubId, date])
  @@index([facilityId, date])
  @@index([userId, createdAt])
  @@index([status, holdExpiresAt])
  @@index([mpPaymentId])
}

/// Cuenta de Mercado Pago del club conectada por OAuth. Los tokens se guardan
/// cifrados (AES-256-GCM, clave PAYMENT_TOKENS_KEY) y nunca salen de la API.
model ClubPaymentAccount {
  id                    String    @id @default(cuid())
  companyId             String
  clubId                String    @unique
  provider              String    @default("mercadopago")
  providerUserId        String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  publicKey             String?
  liveMode              Boolean   @default(false)
  expiresAt             DateTime?
  connectedByUserId     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Actividad que el club ofrece (escuela, clases, entrenamiento) y muestra en la app.
model ClubActivity {
  id          String   @id @default(cuid())
  companyId   String
  clubId      String
  /// Si está, la actividad es la configuración en la app de una disciplina de la
  /// consola (Firestore available_disciplines/{id}): nombre y horarios salen de ahí.
  disciplineId String?
  name        String
  /// Familia de deporte (football, padel…), opcional.
  sport       String?
  /// Público al que apunta: "Infantiles 6 a 12 años", "Adultos principiantes"…
  audience    String?
  description String?
  /// Nombres de los profes que se muestran en la app.
  coaches     String[] @default([])
  /// Horarios semanales: [{ day: 0-6 (lunes = 0), start: "18:00", end: "19:30" }]
  schedule    Json     @default("[]")
  price       Decimal? @db.Decimal(12, 2)
  /// "mes" | "clase" | "semana" | "trimestre" | "año"
  priceUnit   String?
  showPrice   Boolean  @default(false)
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inquiries ActivityInquiry[]

  @@unique([clubId, disciplineId])
  @@index([companyId, clubId])
  @@index([clubId, isPublic])
}

enum ActivityInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/// "Consultar disponibilidad" de un usuario sobre una actividad.
model ActivityInquiry {
  id         String                @id @default(cuid())
  companyId  String
  clubId     String
  activityId String
  userId     String
  message    String?
  status     ActivityInquiryStatus @default(NEW)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  club     Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  activity ClubActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, clubId, status])
  @@index([userId, activityId])
}

enum TournamentStatus {
  DRAFT // borrador: solo lo ve el club
  PUBLISHED // visible en la app; acepta inscripciones hasta la fecha límite o el cupo
  CLOSED // visible, inscripciones cerradas
  FINISHED // terminado (sale del listado de próximos)
}

/// Torneo abierto que el club organiza y publica en la app (distinto del fixture interno).
model ClubTournament {
  id                   String           @id @default(cuid())
  companyId            String
  clubId               String
  name                 String
  /// Familia de deporte (football, padel…) y variante opcional (futbol_5, padel…).
  sport                String
  variant              String?
  /// "Libre +18", "Mixto", "Categoría 2010"…
  category             String?
  /// individual | pareja | equipo
  entryType            String           @default("equipo")
  description          String?
  /// Días y horarios: [{ date: "2026-11-07", start: "09:00", end: "18:00" }]
  days                 Json             @default("[]")
  /// Sedes: [{ name, address }]
  venues               Json             @default("[]")
  organizers           String[]         @default([])
  contactPhone         String?
  contactEmail         String?
  registrationFee      Decimal?         @db.Decimal(12, 2)
  /// por equipo | por pareja | por persona
  feeUnit              String?
  registrationDeadline String?
  maxEntries           Int?
  prizes               String[]         @default([])
  rules                String?
  status               TournamentStatus @default(DRAFT)
  /// Primer día del torneo (YYYY-MM-DD), derivado de days, para ordenar y filtrar.
  startDate            String?
  endDate              String?
  publishedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  entries TournamentEntry[]

  @@index([companyId, clubId])
  @@index([status, sport, startDate])
}

enum TournamentEntryStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Inscripción de un usuario de la app a un torneo (el club la acepta o rechaza).
model TournamentEntry {
  id           String                @id @default(cuid())
  companyId    String
  clubId       String
  tournamentId String
  userId       String
  teamName     String?
  message      String?
  status       TournamentEntryStatus @default(PENDING)
  reviewNote   String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tournament ClubTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status])
  @@index([userId])
  @@index([companyId, clubId])
}

/// Configuración global de la plataforma (una sola fila, id "global"). La edita el dueño de Fluxion.
model PlatformSettings {
  id                   String   @id @default("global")
  /// Cargo de Fluxion al club por publicar un torneo (0 = no se cobra).
  tournamentPublishFee Decimal  @default(0) @db.Decimal(12, 2)
  /// Cargo de Fluxion al club por cada inscripción confirmada (0 = no se cobra).
  tournamentEntryFee   Decimal  @default(0) @db.Decimal(12, 2)
  currency             String   @default("ARS")
  updatedByUid         String?
  updatedAt            DateTime @updatedAt
}

enum PlatformChargeStatus {
  PENDING
  PAID
  VOIDED
}

/// Cargo que Fluxion le factura a un club (torneo publicado, inscripción confirmada).
model PlatformCharge {
  id           String               @id @default(cuid())
  companyId    String
  clubId       String
  /// tournament_published | tournament_entry
  kind         String
  /// Evita cobrar dos veces lo mismo: "tournament:<id>" o "entry:<id>".
  sourceKey    String               @unique
  tournamentId String?
  amount       Decimal              @db.Decimal(12, 2)
  currency     String               @default("ARS")
  description  String
  status       PlatformChargeStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
  @@index([status, createdAt])
}

/// Administradores de la plataforma Fluxion (no confundir con el admin de una empresa).
model PlatformAdmin {
  id           String   @id @default(cuid())
  firebaseUid  String   @unique
  email        String
  /// SUPERADMIN (todo) | SUPPORT (solo lectura)
  role         String   @default("SUPERADMIN")
  active       Boolean  @default(true)
  createdByUid String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Registro inmutable de acciones de plataforma (un trigger impide editar o borrar).
model AuditLog {
  id         String   @id @default(cuid())
  actorUid   String
  actorEmail String?
  /// p. ej. subscription.suspend, platform.settings.update, charge.mark
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUid])
}

/// Plan de suscripción que Fluxion le vende a los clubes.
model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         String
  description  String?
  monthlyPrice Decimal  @db.Decimal(12, 2)
  currency     String   @default("ARS")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions ClubSubscription[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// Suscripción de un club a Fluxion (una por club).
model ClubSubscription {
  id              String             @id @default(cuid())
  companyId       String
  clubId          String             @unique
  planId          String
  /// Precio pactado con el club (si está vacío se usa el del plan).
  customPrice     Decimal?           @db.Decimal(12, 2)
  status          SubscriptionStatus @default(ACTIVE)
  /// Día del mes en que vence cada mensualidad (1-28).
  billingDay      Int                @default(10)
  startedAt       DateTime           @default(now())
  trialEndsAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  cancelledAt     DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  club     Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([status])
}

enum SubscriptionInvoiceStatus {
  PENDING
  PAID
  VOID
}

/// Mensualidad de un club (una por suscripción y mes).
model SubscriptionInvoice {
  id             String                    @id @default(cuid())
  subscriptionId String
  companyId      String
  clubId         String
  /// Mes facturado: "2026-10"
  period         String
  amount         Decimal                   @db.Decimal(12, 2)
  currency       String                    @default("ARS")
  dueDate        DateTime
  status         SubscriptionInvoiceStatus @default(PENDING)
  paidAt         DateTime?
  paymentMethod  String?
  paymentRef     String?
  notes          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  subscription ClubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, period])
  @@index([status, dueDate])
  @@index([clubId, period])
}
