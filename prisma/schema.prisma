// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  scheduled
  live
  played
  canceled
}

enum MatchEventType {
  goal
  own_goal
  yellow_card
  red_card
  substitution
  note
}

enum MatchCallupStatus {
  pending
  confirmed
  unavailable
}

enum FinancialTransactionType {
  income
  expense
}

enum TrainingSessionStatus {
  scheduled
  completed
  canceled
}

enum AttendanceStatus {
  going
  not_going
  unknown
}

enum InjuryStatus {
  active
  recovered
}

enum PaymentStatus {
  paid
  pending
  overdue
}

enum ShopOrderStatus {
  pending
  preparing
  ready
  delivered
  cancelled
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipalities        Municipality[]
  users                 User[]
  clubs                 Club[]
  leagues               League[]
  teams                 Team[]
  players               Player[]
  members               Member[]
  matches               Match[]
  matchEvents           MatchEvent[]
  matchCallups          MatchCallup[]
  financialTransactions FinancialTransaction[]
  playerPayments        PlayerPayment[]
  shopProducts          ShopProduct[]
  shopOrders            ShopOrder[]
  facilities            Facility[]
  facilityRentals       FacilityRental[]
  trainingSessions      TrainingSession[]
  trainingAttendances   TrainingAttendance[]
  injuryReports         InjuryReport[]
  membershipPlans       MembershipPlan[]
}

model Municipality {
  id        String   @id @default(cuid())
  name      String
  address   String?
  centerLat Float?
  centerLng Float?
  status    String?  @default("active")
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clubs   Club[]
  leagues League[]

  @@index([companyId])
  @@index([companyId, name])
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  name        String?
  role        String   @default("user")
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, role])
}

model Club {
  id               String   @id @default(cuid())
  name             String
  leagueId         String?
  municipalityId   String?
  municipalityName String?
  address          String?
  sport            String?
  status           String?
  companyId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  league       League?       @relation("LeagueClubs", fields: [leagueId], references: [id], onDelete: SetNull)
  primaryLeagues League[]    @relation("ClubPrimaryLeague")
  teams        Team[]
  players      Player[]
  members      Member[]
  financialTransactions FinancialTransaction[]
  playerPayments        PlayerPayment[]
  shopProducts          ShopProduct[]
  shopOrders            ShopOrder[]
  facilities            Facility[]
  facilityRentals       FacilityRental[]
  trainingSessions      TrainingSession[]
  injuryReports         InjuryReport[]
  membershipPlans       MembershipPlan[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([leagueId])
  @@index([municipalityId])
}

model League {
  id        String   @id @default(cuid())
  name      String
  season    String?
  companyId String
  clubId    String?
  municipalityId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club         Club?         @relation("ClubPrimaryLeague", fields: [clubId], references: [id], onDelete: SetNull)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  clubs        Club[]        @relation("LeagueClubs")
  teams        Team[]
  matches      Match[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([clubId])
  @@index([municipalityId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  category  String?
  companyId String
  clubId    String
  leagueId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  league  League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  players Player[]
  homeMatches Match[] @relation("HomeTeamMatches")
  awayMatches Match[] @relation("AwayTeamMatches")
  matchEvents MatchEvent[]
  trainingSessions TrainingSession[]
  injuryReports InjuryReport[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([leagueId])
}

model Player {
  id                 String    @id @default(cuid())
  authUid            String?   @unique
  email              String?   @unique
  photoUrl           String?
  firstName          String
  lastName           String
  dni                String?
  position           String?
  birthDate          DateTime?
  phone              String?
  address            String?
  locality           String?
  province           String?
  active             Boolean   @default(true)
  companyId          String
  clubId             String
  teamId             String?
  // Membership
  membershipTier     String?
  membershipCategory String?
  membershipPlanId   String?
  isFamilyPlan       Boolean   @default(false)
  parking            Boolean   @default(false)
  paymentMethod      String?
  notes              String?
  facilitiesAccess   Json?
  extrasAccess       Json?
  familyMembers      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club           Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  membershipPlan MembershipPlan?  @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  matchEvents         MatchEvent[]
  playerPayments      PlayerPayment[]
  trainingAttendances TrainingAttendance[]
  injuryReports       InjuryReport[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([authUid])
  @@index([teamId])
  @@index([membershipPlanId])
  @@unique([companyId, dni])
}

model Member {
  id                 String    @id @default(cuid())
  authUid            String?   @unique
  email              String?   @unique
  photoUrl           String?
  firstName          String
  lastName           String
  dni                String?
  birthDate          DateTime?
  phone              String?
  address            String?
  locality           String?
  province           String?
  isFan              Boolean   @default(false)
  active             Boolean   @default(true)
  status             String?   @default("active")
  companyId          String
  clubId             String
  // Membership
  membershipNumber   String?
  membershipTier     String?
  membershipCategory String?
  membershipPlanId   String?
  isFamilyPlan       Boolean   @default(false)
  parking            Boolean   @default(false)
  paymentMethod      String?
  notes              String?
  facilitiesAccess   Json?
  extrasAccess       Json?
  familyMembers      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club           Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  membershipPlan MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([authUid])
  @@index([membershipPlanId])
  @@index([isFan])
  @@unique([companyId, dni])
}

model Match {
  id          String      @id @default(cuid())
  companyId   String
  leagueId    String
  homeTeamId  String
  awayTeamId  String
  scheduledAt DateTime
  status      MatchStatus @default(scheduled)
  homeScore   Int         @default(0)
  awayScore   Int         @default(0)
  venue       String?
  busDepartureTime String?
  jersey      String?
  callupsPublishedAt DateTime?
  lineupSubmittedAt DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  league    League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam  Team    @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam  Team    @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Cascade)
  events    MatchEvent[]
  callups   MatchCallup[]

  @@index([companyId])
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([companyId, status])
}

model MatchCallup {
  id               String           @id @default(cuid())
  companyId        String
  matchId          String
  playerExternalId String
  playerName       String
  playerPhoto      String?
  status           MatchCallupStatus @default(pending)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerExternalId])
  @@index([companyId])
  @@index([matchId])
  @@index([playerExternalId])
  @@index([companyId, playerExternalId])
  @@index([companyId, publishedAt])
}

model MatchEvent {
  id         String         @id @default(cuid())
  companyId  String
  matchId    String
  teamId     String?
  playerId   String?
  minute     Int?
  type       MatchEventType
  note       String?
  createdAt  DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player  Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
}

model FinancialTransaction {
  id          String                   @id @default(cuid())
  companyId   String
  clubId      String?
  type        FinancialTransactionType
  category    String
  amount      Decimal                  @db.Decimal(12, 2)
  currency    String                   @default("ARS")
  occurredAt  DateTime
  description String?
  reference   String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, type])
  @@index([companyId, occurredAt])
}

model PlayerPayment {
  id            String        @id @default(cuid())
  companyId     String
  clubId        String
  playerId      String
  month         Int
  year          Int
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  paymentMethod String?
  paymentDate   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([playerId])
  @@index([companyId, clubId])
  @@index([companyId, playerId])
  @@index([companyId, status])
  @@unique([playerId, month, year])
}

model ShopProduct {
  id          String   @id @default(cuid())
  companyId   String
  clubId      String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  category    String
  images      Json?
  sizes       Json?
  sports      Json?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  orders  ShopOrder[]

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, clubId])
}

model ShopOrder {
  id                 String          @id @default(cuid())
  companyId          String
  clubId             String
  customerExternalId String
  customerName       String
  productId          String?
  productName        String
  productImage       String?
  size               String?
  price              Decimal         @db.Decimal(12, 2)
  status             ShopOrderStatus @default(pending)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  product ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([productId])
  @@index([customerExternalId])
  @@index([companyId, clubId])
  @@index([companyId, customerExternalId])
  @@index([companyId, status])
}

model Facility {
  id           String   @id @default(cuid())
  companyId    String
  clubId       String
  name         String
  type         String
  typeLabel    String?
  status       String
  statusLabel  String?
  photoUrl     String?
  address      String?
  neighborhood String?
  surfaceType  String?
  services     Json?
  capacity     Json?
  meta         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rentals FacilityRental[]

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, clubId])
}

model FacilityRental {
  id          String   @id @default(cuid())
  companyId   String
  clubId      String
  facilityId  String
  clientName  String
  clientPhone String?
  status      String   @default("confirmed")
  isRecurrent Boolean  @default(false)
  day         String
  hour        Int
  price       Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([facilityId])
  @@index([companyId, clubId])
  @@index([companyId, facilityId])
  @@index([companyId, day, hour])
}

model TrainingSession {
  id          String                @id @default(cuid())
  companyId   String
  clubId      String
  teamId      String?
  title       String
  scheduledAt DateTime
  status      TrainingSessionStatus @default(scheduled)
  location    String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team        Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  attendances TrainingAttendance[]

  @@index([companyId])
  @@index([clubId])
  @@index([teamId])
  @@index([scheduledAt])
  @@index([companyId, scheduledAt])
}

model TrainingAttendance {
  id         String           @id @default(cuid())
  companyId  String
  sessionId  String
  playerId   String
  status     AttendanceStatus @default(unknown)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([companyId])
  @@index([sessionId])
  @@index([playerId])
  @@index([companyId, status])
}

model InjuryReport {
  id          String       @id @default(cuid())
  companyId   String
  clubId      String
  teamId      String?
  playerId    String
  description String
  status      InjuryStatus @default(active)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([teamId])
  @@index([playerId])
  @@index([companyId, status])
}

model MembershipPlan {
  id                String   @id @default(cuid())
  companyId         String
  clubId            String
  name              String
  description       String?
  price             Decimal  @default(0) @db.Decimal(12, 2)
  parkingPrice      Decimal  @default(0) @db.Decimal(12, 2)
  familyMemberPrice Decimal  @default(0) @db.Decimal(12, 2)
  facilities        Json?
  extras            Json?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  players Player[]
  members Member[]

  @@index([companyId])
  @@index([clubId])
}
