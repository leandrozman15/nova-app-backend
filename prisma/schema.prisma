// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  scheduled
  live
  played
  canceled
  suspended
}

enum MatchEventType {
  goal
  own_goal
  yellow_card
  red_card
  substitution
  note
}

enum MatchCallupStatus {
  pending
  confirmed
  unavailable
}

enum FinancialTransactionType {
  income
  expense
}

enum TrainingSessionStatus {
  scheduled
  completed
  canceled
}

enum AttendanceStatus {
  going
  not_going
  unknown
}

enum InjuryStatus {
  active
  recovered
}

enum PaymentStatus {
  paid
  pending
  overdue
}

enum ShopOrderStatus {
  pending
  preparing
  ready
  delivered
  cancelled
}

enum ClubMembershipStatus {
  SOLICITADA
  ACTIVA
  RECHAZADA
  BAJA
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipalities        Municipality[]
  users                 User[]
  clubMemberships       ClubMembership[]
  clubs                 Club[]
  leagues               League[]
  teams                 Team[]
  players               Player[]
  members               Member[]
  matches               Match[]
  matchEvents           MatchEvent[]
  matchCallups          MatchCallup[]
  financialTransactions FinancialTransaction[]
  playerPayments        PlayerPayment[]
  shopProducts          ShopProduct[]
  shopOrders            ShopOrder[]
  facilities            Facility[]
  facilityRentals       FacilityRental[]
  clubActivities        ClubActivity[]
  clubTournaments       ClubTournament[]
  trainingSessions      TrainingSession[]
  attendanceSessions    AttendanceSession[]
  trainingAttendances   TrainingAttendance[]
  injuryReports         InjuryReport[]
  membershipPlans       MembershipPlan[]
}

model Municipality {
  id        String   @id @default(cuid())
  name      String
  address   String?
  centerLat Float?
  centerLng Float?
  status    String?  @default("active")
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clubs   Club[]
  leagues League[]

  @@index([companyId])
  @@index([companyId, name])
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  name        String?
  role        String   @default("user")
  // null = usuario libre (registrado desde la app pública, sin empresa).
  companyId   String?
  // Perfil del usuario libre (lo completa desde la app pública).
  phone       String?
  city        String?
  sports      String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clubMemberships ClubMembership[]
  bookings        Booking[]
  activityInquiries ActivityInquiry[]
  tournamentEntries TournamentEntry[]
  merchantMemberships MerchantMember[]
  storeOrders       StoreOrder[]

  @@index([companyId])
  @@index([companyId, role])
}

model Club {
  id               String   @id @default(cuid())
  name             String
  legalName        String?
  cuit             String?
  foundationDate   DateTime?
  leagueId         String?
  municipalityId   String?
  municipalityName String?
  address          String?
  city             String?
  phone            String?
  email            String?
  billingEmail     String?
  website          String?
  instagram        String?
  facebook         String?
  logoUrl          String?
  // Foto de portada de la ficha pública (Storage del club, https).
  coverUrl         String?
  description      String?
  sport            String?
  status           String?
  // Vidriera pública: ubicación y qué secciones se muestran a usuarios libres.
  latitude         Float?
  longitude        Float?
  isPublic         Boolean  @default(false)
  publicFacilities Boolean  @default(false)
  publicSchools    Boolean  @default(false)
  publicCoaches    Boolean  @default(false)
  publicShop       Boolean  @default(false)
  // Reservas online: zona horaria de los turnos y % de seña sobre el precio.
  timezone         String   @default("America/Argentina/Buenos_Aires")
  depositPercent   Int      @default(30)
  // Reservas desde la app: off | request (sin seña, confirma el club) | deposit (seña por Mercado Pago).
  bookingMode      String   @default("off")
  // Horario de turnos (minutos desde las 00:00; 1440 = medianoche) y seña sin pasarela.
  openMinute       Int      @default(480)
  closeMinute      Int      @default(1440)
  requireDeposit   Boolean  @default(false)
  depositAlias     String?
  depositHoldHours Int      @default(12)
  // Servicios del club (catálogo src/clubs/club-amenities.ts): wifi, vestuarios, duchas…
  amenities        String[] @default([])
  companyId        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  league       League?       @relation("LeagueClubs", fields: [leagueId], references: [id], onDelete: SetNull)
  primaryLeagues League[]    @relation("ClubPrimaryLeague")
  leagueTournamentEntries LeagueTournamentClub[]
  teams        Team[]
  players      Player[]
  /// Etapas de la salida de Firestore ya copiadas para este club ({ "stage1": "2026-10-13T…" }).
  firestoreMigration Json?
  disciplines  ClubDiscipline[]
  divisions    Division[]
  members      Member[]
  memberships  ClubMembership[]
  financialTransactions FinancialTransaction[]
  playerPayments        PlayerPayment[]
  shopProducts          ShopProduct[]
  shopOrders            ShopOrder[]
  facilities            Facility[]
  facilityRentals       FacilityRental[]
  trainingSessions      TrainingSession[]
  attendanceSessions    AttendanceSession[]
  injuryReports         InjuryReport[]
  membershipPlans       MembershipPlan[]
  bookings              Booking[]
  recurringBookings     RecurringBooking[]
  paymentAccount        ClubPaymentAccount?
  activities            ClubActivity[]
  activityInquiries     ActivityInquiry[]
  tournaments           ClubTournament[]
  platformCharges       PlatformCharge[]
  subscription          ClubSubscription?
  subscriptionInvoices  SubscriptionInvoice[]
  storeSettings         ClubStoreSettings?
  storePickupOrders     StoreOrder[] @relation("StoreOrderPickupClub")
  storeSellerOrders     StoreOrder[] @relation("StoreOrderSellerClub")

  @@index([companyId])
  @@index([companyId, name])
  @@index([leagueId])
  @@index([municipalityId])
  @@index([isPublic])
}

model ClubMembership {
  id        String               @id @default(cuid())
  userId    String
  companyId String
  clubId    String
  status    ClubMembershipStatus @default(SOLICITADA)
  role      String
  // Solicitud iniciada por el usuario libre y su revisión por el club.
  message          String?
  reviewedAt       DateTime?
  reviewedByUserId String?
  // Ficha existente del padrón vinculada al aprobar (evita duplicados).
  playerId  String?
  memberId  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player  Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([userId, clubId])
  @@index([companyId, clubId, status])
  @@index([userId, status])
  @@index([playerId])
  @@index([memberId])
}

model League {
  id        String   @id @default(cuid())
  name      String
  season    String?
  companyId String
  clubId    String?
  municipalityId String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent       League?       @relation("LeagueHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subLeagues   League[]      @relation("LeagueHierarchy")
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club         Club?         @relation("ClubPrimaryLeague", fields: [clubId], references: [id], onDelete: SetNull)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  clubs        Club[]        @relation("LeagueClubs")
  teams        Team[]
  matches      Match[]
  announcements LeagueAnnouncement[]
  tournaments   LeagueTournament[]

  @@index([companyId])
  @@index([companyId, name])
  @@index([clubId])
  @@index([municipalityId])
  @@index([parentId])
}

model LeagueAnnouncement {
  id        String   @id @default(cuid())
  leagueId  String
  companyId String
  title     String
  body      String
  pinned    Boolean  @default(false)
  /// Clubes destinatarios; vacío = todos los clubes de la liga.
  clubIds   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@index([leagueId, createdAt])
  @@index([companyId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  category  String?
  companyId String
  clubId    String
  leagueId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  league  League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  players Player[]
  homeMatches Match[] @relation("HomeTeamMatches")
  awayMatches Match[] @relation("AwayTeamMatches")
  matchEvents MatchEvent[]
  trainingSessions TrainingSession[]
  injuryReports InjuryReport[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([leagueId])
}

model Player {
  id                 String    @id @default(cuid())
  authUid            String?   @unique
  email              String?   @unique
  photoUrl           String?
  firstName          String
  lastName           String
  /// Cifrado (AES-256-GCM, ver src/common/pii-crypto.ts). La búsqueda/unicidad va por dniHash.
  dni                String?
  dniHash            String?
  position           String?
  /// Legado: queda en null; la fecha real vive cifrada en birthDateEnc.
  birthDate          DateTime?
  birthDateEnc       String?
  phone              String?
  address            String?
  locality           String?
  province           String?
  active             Boolean   @default(true)
  companyId          String
  clubId             String
  teamId             String?
  // Membership
  membershipTier     String?
  membershipCategory String?
  membershipPlanId   String?
  isFamilyPlan       Boolean   @default(false)
  parking            Boolean   @default(false)
  paymentMethod      String?
  notes              String?
  facilitiesAccess   Json?
  extrasAccess       Json?
  familyMembers      Json?
  /// Id de la ficha en Firestore (antes de la migración). La app lo sigue usando como id del jugador.
  legacyId           String?   @unique
  /// Disciplina (sportId del club), rama/categoría y datos deportivos.
  sport              String?
  divisionId         String?
  branch             String?
  gender             String?
  membershipNumber   String?
  hasMedicalCert     Boolean   @default(false)
  hasMinorAuth       Boolean   @default(false)
  isFan              Boolean   @default(false)
  status             String    @default("active")
  role               String?
  /// Campos de la ficha que no tienen columna propia (equipo de Firestore, extras del formulario).
  extra              Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club           Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  division       Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  membershipPlan MembershipPlan?  @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  matchEvents         MatchEvent[]
  playerPayments      PlayerPayment[]
  trainingAttendances TrainingAttendance[]
  attendanceRecords   AttendanceRecord[]
  injuryReports       InjuryReport[]
  clubMemberships     ClubMembership[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([authUid])
  @@index([teamId])
  @@index([membershipPlanId])
  @@index([clubId, divisionId])
  @@unique([companyId, dniHash])
}

model Member {
  id                 String    @id @default(cuid())
  authUid            String?   @unique
  email              String?   @unique
  photoUrl           String?
  firstName          String
  lastName           String
  /// Cifrado (AES-256-GCM, ver src/common/pii-crypto.ts). La búsqueda/unicidad va por dniHash.
  dni                String?
  dniHash            String?
  /// Legado: queda en null; la fecha real vive cifrada en birthDateEnc.
  birthDate          DateTime?
  birthDateEnc       String?
  phone              String?
  address            String?
  locality           String?
  province           String?
  isFan              Boolean   @default(false)
  active             Boolean   @default(true)
  status             String?   @default("active")
  companyId          String
  clubId             String
  // Membership
  membershipNumber   String?
  membershipTier     String?
  membershipCategory String?
  membershipPlanId   String?
  isFamilyPlan       Boolean   @default(false)
  parking            Boolean   @default(false)
  paymentMethod      String?
  notes              String?
  facilitiesAccess   Json?
  extrasAccess       Json?
  familyMembers      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club           Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  membershipPlan MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  clubMemberships ClubMembership[]

  @@index([companyId])
  @@index([companyId, clubId])
  @@index([authUid])
  @@index([membershipPlanId])
  @@index([isFan])
  @@unique([companyId, dniHash])
}

model Match {
  id          String      @id @default(cuid())
  companyId   String
  leagueId    String
  homeTeamId  String
  awayTeamId  String
  scheduledAt DateTime
  status      MatchStatus @default(scheduled)
  homeScore   Int         @default(0)
  awayScore   Int         @default(0)
  venue       String?
  busDepartureTime String?
  jersey      String?
  callupsPublishedAt DateTime?
  lineupSubmittedAt DateTime?
  notes       String?
  tournamentId String?
  round       Int?
  /// group | knockout | third_place | league
  stage       String?
  groupName   String?
  label       String?
  bracketSlot Int?
  homePens    Int?
  awayPens    Int?
  /// Fecha original cuando el partido fue reprogramado por una suspensión.
  originalScheduledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tournament LeagueTournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  league    League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam  Team    @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam  Team    @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Cascade)
  events    MatchEvent[]
  callups   MatchCallup[]
  suspensions MatchSuspension[]
  categoryResults MatchCategoryResult[]

  @@index([tournamentId])
  @@index([companyId])
  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([companyId, status])
}

/// Suspensión de un partido por un club: de todas sus categorías (categories vacío) o solo de algunas.
model MatchSuspension {
  id           String    @id @default(cuid())
  companyId    String
  matchId      String
  clubId       String?
  categories   String[]
  reason       String
  suspendedBy  String?
  suspendedAt  DateTime  @default(now())
  /// open | rescheduled | lifted
  state        String    @default("open")
  newDate      DateTime?
  newVenue     String?
  rescheduleNote String?
  resolvedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([companyId, state])
}

/// Resultado de una categoría dentro de un partido de liga (la tabla se calcula por categoría).
model MatchCategoryResult {
  id        String   @id @default(cuid())
  companyId String
  matchId   String
  category  String
  homeScore Int      @default(0)
  awayScore Int      @default(0)
  /// played | walkover_home (gana el local, el visitante no presentó equipo) | walkover_away
  outcome   String   @default("played")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, category])
  @@index([companyId])
}

model MatchCallup {
  id               String           @id @default(cuid())
  companyId        String
  matchId          String
  playerExternalId String
  playerName       String
  playerPhoto      String?
  status           MatchCallupStatus @default(pending)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerExternalId])
  @@index([companyId])
  @@index([matchId])
  @@index([playerExternalId])
  @@index([companyId, playerExternalId])
  @@index([companyId, publishedAt])
}

model MatchEvent {
  id         String         @id @default(cuid())
  companyId  String
  matchId    String
  teamId     String?
  playerId   String?
  minute     Int?
  type       MatchEventType
  note       String?
  createdAt  DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player  Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
}

model FinancialTransaction {
  id          String                   @id @default(cuid())
  companyId   String
  clubId      String?
  type        FinancialTransactionType
  category    String
  amount      Decimal                  @db.Decimal(12, 2)
  currency    String                   @default("ARS")
  occurredAt  DateTime
  description String?
  reference   String?
  /// Movimiento enviado al archivo: sigue contando en totales y reportes, pero sale del libro activo.
  archivedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, type])
  @@index([companyId, occurredAt])
}

model PlayerPayment {
  id            String        @id @default(cuid())
  companyId     String
  clubId        String
  playerId      String
  month         Int
  year          Int
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  paymentMethod String?
  paymentDate   DateTime?
  // Cobro online de la cuota por Mercado Pago (cuenta del club).
  mpPreferenceId  String?
  mpPaymentId     String?
  mpPaymentStatus String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([playerId])
  @@index([companyId, clubId])
  @@index([companyId, playerId])
  @@index([companyId, status])
  @@index([mpPaymentId])
  @@unique([playerId, month, year])
}

model ShopProduct {
  id          String   @id @default(cuid())
  companyId   String
  clubId      String
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  category    String
  images      Json?
  sizes       Json?
  sports      Json?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  orders  ShopOrder[]
  storeOrderItems StoreOrderItem[]

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, clubId])
}

model ShopOrder {
  id                 String          @id @default(cuid())
  companyId          String
  clubId             String
  customerExternalId String
  customerName       String
  productId          String?
  productName        String
  productImage       String?
  size               String?
  price              Decimal         @db.Decimal(12, 2)
  status             ShopOrderStatus @default(pending)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  product ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([productId])
  @@index([customerExternalId])
  @@index([companyId, clubId])
  @@index([companyId, customerExternalId])
  @@index([companyId, status])
}

model Facility {
  id           String   @id @default(cuid())
  companyId    String
  clubId       String
  name         String
  type         String
  typeLabel    String?
  // Deporte de la cancha (catálogo src/facilities/facility-sports.ts), para filtros.
  sport        String?
  status       String
  statusLabel  String?
  photoUrl     String?
  // Galería pública (hasta 12 URLs https); photoUrl es la portada.
  photos       String[] @default([])
  address      String?
  neighborhood String?
  surfaceType  String?
  services     Json?
  capacity     Json?
  meta         Json?
  // Reservas online desde la app pública.
  bookable     Boolean  @default(false)
  hourlyPrice  Decimal? @db.Decimal(12, 2)
  // Duraciones de turno que ofrece la cancha (minutos: 30, 60, 90, 120).
  slotDurations Int[]   @default([60])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club     Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  rentals  FacilityRental[]
  bookings Booking[]
  recurringBookings RecurringBooking[]

  @@index([companyId])
  @@index([clubId])
  @@index([companyId, clubId])
  @@index([sport])
}

model FacilityRental {
  id          String   @id @default(cuid())
  companyId   String
  clubId      String
  facilityId  String
  clientName  String
  clientPhone String?
  status      String   @default("confirmed")
  isRecurrent Boolean  @default(false)
  day         String
  hour        Int
  price       Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([facilityId])
  @@index([companyId, clubId])
  @@index([companyId, facilityId])
  @@index([companyId, day, hour])
}

model TrainingSession {
  id          String                @id @default(cuid())
  companyId   String
  clubId      String
  teamId      String?
  title       String
  scheduledAt DateTime
  status      TrainingSessionStatus @default(scheduled)
  location    String?
  notes       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team        Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  attendances TrainingAttendance[]

  @@index([companyId])
  @@index([clubId])
  @@index([teamId])
  @@index([scheduledAt])
  @@index([companyId, scheduledAt])
}

model TrainingAttendance {
  id         String           @id @default(cuid())
  companyId  String
  sessionId  String
  playerId   String
  status     AttendanceStatus @default(unknown)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([companyId])
  @@index([sessionId])
  @@index([playerId])
  @@index([companyId, status])
}

model InjuryReport {
  id          String       @id @default(cuid())
  companyId   String
  clubId      String
  teamId      String?
  playerId    String
  description String
  status      InjuryStatus @default(active)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([clubId])
  @@index([teamId])
  @@index([playerId])
  @@index([companyId, status])
}

model MembershipPlan {
  id                String   @id @default(cuid())
  companyId         String
  clubId            String
  name              String
  description       String?
  price             Decimal  @default(0) @db.Decimal(12, 2)
  parkingPrice      Decimal  @default(0) @db.Decimal(12, 2)
  familyMemberPrice Decimal  @default(0) @db.Decimal(12, 2)
  facilities        Json?
  extras            Json?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  players Player[]
  members Member[]

  @@index([companyId])
  @@index([clubId])
}

enum BookingStatus {
  REQUESTED // solicitud sin seña: turno retenido hasta que el club confirme o rechace
  PENDING_PAYMENT // turno retenido mientras se paga la seña
  CONFIRMED // seña aprobada por Mercado Pago
  EXPIRED // no se pagó a tiempo; el turno se liberó
  CANCELLED_BY_USER
  CANCELLED_BY_CLUB
}

/// Reserva de un turno (fecha + hora) hecha desde la app pública.
/// Un índice único parcial (en la migración) impide dos reservas activas
/// (PENDING_PAYMENT o CONFIRMED) en la misma cancha, fecha y hora.
model Booking {
  id            String        @id @default(cuid())
  companyId     String
  clubId        String
  facilityId    String
  /// null en turnos cargados por el club (fijos o manuales).
  userId        String?
  /// Fecha local del club (YYYY-MM-DD) y hora de inicio (0-23).
  date          String
  hour          Int
  /// Inicio en minutos desde las 00:00 (p. ej. 1290 = 21:30) y duración.
  startMinute     Int
  durationMinutes Int       @default(60)
  startsAt      DateTime
  endsAt        DateTime
  /// APP (desde la app) | CLUB (cargado en la consola) | FIXED (turno fijo semanal)
  source        String        @default("APP")
  /// ALQUILER | ENTRENAMIENTO | PARTIDO | MANTENIMIENTO
  kind          String        @default("ALQUILER")
  recurringId   String?
  /// SHOWED | NO_SHOW (lo marca el encargado)
  attendance    String?
  /// Seña cobrada sin pasarela: efectivo o transferencia.
  depositMethod String?
  depositPaidAt DateTime?
  /// Total cobrado del turno (seña + saldo).
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod String?
  notes         String?
  createdByUid  String?
  status        BookingStatus @default(PENDING_PAYMENT)
  currency      String        @default("ARS")
  price         Decimal       @db.Decimal(12, 2)
  depositAmount Decimal       @db.Decimal(12, 2)
  holdExpiresAt DateTime
  contactName   String?
  contactPhone  String?
  // Mercado Pago
  mpPreferenceId  String?
  mpPaymentId     String?
  mpPaymentStatus String?
  paidAt          DateTime?
  refundedAt      DateTime?
  cancelReason    String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  facility  Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurring RecurringBooking? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([recurringId, date])
  @@index([companyId, clubId, date])
  @@index([facilityId, date])
  @@index([userId, createdAt])
  @@index([status, holdExpiresAt])
  @@index([mpPaymentId])
}

/// Cuenta de Mercado Pago del club conectada por OAuth. Los tokens se guardan
/// cifrados (AES-256-GCM, clave PAYMENT_TOKENS_KEY) y nunca salen de la API.
model ClubPaymentAccount {
  id                    String    @id @default(cuid())
  companyId             String
  clubId                String    @unique
  provider              String    @default("mercadopago")
  providerUserId        String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  publicKey             String?
  liveMode              Boolean   @default(false)
  expiresAt             DateTime?
  connectedByUserId     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Actividad que el club ofrece (escuela, clases, entrenamiento) y muestra en la app.
model ClubActivity {
  id          String   @id @default(cuid())
  companyId   String
  clubId      String
  /// Si está, la actividad es la configuración en la app de una disciplina de la
  /// consola (Firestore available_disciplines/{id}): nombre y horarios salen de ahí.
  disciplineId String?
  name        String
  /// Familia de deporte (football, padel…), opcional.
  sport       String?
  /// Público al que apunta: "Infantiles 6 a 12 años", "Adultos principiantes"…
  audience    String?
  description String?
  /// Nombres de los profes que se muestran en la app.
  coaches     String[] @default([])
  /// Horarios semanales: [{ day: 0-6 (lunes = 0), start: "18:00", end: "19:30" }]
  schedule    Json     @default("[]")
  price       Decimal? @db.Decimal(12, 2)
  /// "mes" | "clase" | "semana" | "trimestre" | "año"
  priceUnit   String?
  showPrice   Boolean  @default(false)
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inquiries ActivityInquiry[]

  @@unique([clubId, disciplineId])
  @@index([companyId, clubId])
  @@index([clubId, isPublic])
}

enum ActivityInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/// "Consultar disponibilidad" de un usuario sobre una actividad.
model ActivityInquiry {
  id         String                @id @default(cuid())
  companyId  String
  clubId     String
  activityId String
  userId     String
  message    String?
  status     ActivityInquiryStatus @default(NEW)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  club     Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  activity ClubActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, clubId, status])
  @@index([userId, activityId])
}

enum TournamentStatus {
  DRAFT // borrador: solo lo ve el club
  PUBLISHED // visible en la app; acepta inscripciones hasta la fecha límite o el cupo
  CLOSED // visible, inscripciones cerradas
  FINISHED // terminado (sale del listado de próximos)
}

/// Torneo abierto que el club organiza y publica en la app (distinto del fixture interno).
model ClubTournament {
  id                   String           @id @default(cuid())
  companyId            String
  clubId               String
  name                 String
  /// Familia de deporte (football, padel…) y variante opcional (futbol_5, padel…).
  sport                String
  variant              String?
  /// "Libre +18", "Mixto", "Categoría 2010"…
  category             String?
  /// individual | pareja | equipo
  entryType            String           @default("equipo")
  description          String?
  /// Días y horarios: [{ date: "2026-11-07", start: "09:00", end: "18:00" }]
  days                 Json             @default("[]")
  /// Sedes: [{ name, address }]
  venues               Json             @default("[]")
  organizers           String[]         @default([])
  contactPhone         String?
  contactEmail         String?
  registrationFee      Decimal?         @db.Decimal(12, 2)
  /// por equipo | por pareja | por persona
  feeUnit              String?
  registrationDeadline String?
  maxEntries           Int?
  prizes               String[]         @default([])
  rules                String?
  status               TournamentStatus @default(DRAFT)
  /// Primer día del torneo (YYYY-MM-DD), derivado de days, para ordenar y filtrar.
  startDate            String?
  endDate              String?
  publishedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  entries TournamentEntry[]

  @@index([companyId, clubId])
  @@index([status, sport, startDate])
}

enum TournamentEntryStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Inscripción de un usuario de la app a un torneo (el club la acepta o rechaza).
model TournamentEntry {
  id           String                @id @default(cuid())
  companyId    String
  clubId       String
  tournamentId String
  userId       String
  teamName     String?
  message      String?
  status       TournamentEntryStatus @default(PENDING)
  reviewNote   String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tournament ClubTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status])
  @@index([userId])
  @@index([companyId, clubId])
}

/// Configuración global de la plataforma (una sola fila, id "global"). La edita el dueño de Fluxion.
model PlatformSettings {
  id                   String   @id @default("global")
  /// Cargo de Fluxion al club por publicar un torneo (0 = no se cobra).
  tournamentPublishFee Decimal  @default(0) @db.Decimal(12, 2)
  /// Cargo de Fluxion al club por cada inscripción confirmada (0 = no se cobra).
  tournamentEntryFee   Decimal  @default(0) @db.Decimal(12, 2)
  /// Rangos permitidos para las comisiones de la tienda (en %).
  commissionPlatformMin Decimal @default(0) @db.Decimal(5, 2)
  commissionPlatformMax Decimal @default(30) @db.Decimal(5, 2)
  commissionClubMin     Decimal @default(0) @db.Decimal(5, 2)
  commissionClubMax     Decimal @default(15) @db.Decimal(5, 2)
  currency             String   @default("ARS")
  updatedByUid         String?
  updatedAt            DateTime @updatedAt
}

enum PlatformChargeStatus {
  PENDING
  PAID
  VOIDED
}

/// Cargo que Fluxion le factura a un club (torneo publicado, inscripción confirmada).
model PlatformCharge {
  id           String               @id @default(cuid())
  companyId    String
  clubId       String
  /// tournament_published | tournament_entry
  kind         String
  /// Evita cobrar dos veces lo mismo: "tournament:<id>" o "entry:<id>".
  sourceKey    String               @unique
  tournamentId String?
  amount       Decimal              @db.Decimal(12, 2)
  currency     String               @default("ARS")
  description  String
  status       PlatformChargeStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, status])
  @@index([status, createdAt])
}

/// Administradores de la plataforma Fluxion (no confundir con el admin de una empresa).
model PlatformAdmin {
  id           String   @id @default(cuid())
  firebaseUid  String   @unique
  email        String
  /// SUPERADMIN (todo) | SUPPORT (solo lectura)
  role         String   @default("SUPERADMIN")
  active       Boolean  @default(true)
  createdByUid String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Registro inmutable de acciones de plataforma (un trigger impide editar o borrar).
model AuditLog {
  id         String   @id @default(cuid())
  actorUid   String
  actorEmail String?
  /// p. ej. subscription.suspend, platform.settings.update, charge.mark
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUid])
}

/// Plan de suscripción que Fluxion le vende a los clubes.
model SubscriptionPlan {
  id           String   @id @default(cuid())
  name         String
  description  String?
  monthlyPrice Decimal  @db.Decimal(12, 2)
  currency     String   @default("ARS")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions ClubSubscription[]
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// Suscripción de un club a Fluxion (una por club).
model ClubSubscription {
  id              String             @id @default(cuid())
  companyId       String
  clubId          String             @unique
  planId          String
  /// Precio pactado con el club (si está vacío se usa el del plan).
  customPrice     Decimal?           @db.Decimal(12, 2)
  status          SubscriptionStatus @default(ACTIVE)
  /// Día del mes en que vence cada mensualidad (1-28).
  billingDay      Int                @default(10)
  startedAt       DateTime           @default(now())
  trialEndsAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  cancelledAt     DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  club     Club                  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([status])
}

enum SubscriptionInvoiceStatus {
  PENDING
  PAID
  VOID
}

/// Mensualidad de un club (una por suscripción y mes).
model SubscriptionInvoice {
  id             String                    @id @default(cuid())
  subscriptionId String
  companyId      String
  clubId         String
  /// Mes facturado: "2026-10"
  period         String
  amount         Decimal                   @db.Decimal(12, 2)
  currency       String                    @default("ARS")
  dueDate        DateTime
  status         SubscriptionInvoiceStatus @default(PENDING)
  paidAt         DateTime?
  paymentMethod  String?
  paymentRef     String?
  notes          String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  subscription ClubSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, period])
  @@index([status, dueDate])
  @@index([clubId, period])
}

// ─── Tienda: comercios, comisiones y pedidos ──────────────────────────────────

enum MerchantStatus {
  INVITADO
  ACTIVO
  SUSPENDIDO
}

enum MerchantRole {
  ADMIN_COMERCIO
  OPERADOR
}

/// Comercio que vende en la tienda de la app. Solo lo da de alta un administrador de Fluxion.
model Merchant {
  id                 String         @id @default(cuid())
  /// Datos fiscales (los edita solo Fluxion).
  legalName          String
  tradeName          String
  cuit               String         @unique
  ivaCondition       String
  /// Contacto y datos públicos (los completa el comercio).
  contactName        String?
  contactEmail       String
  contactPhone       String?
  address            String?
  city               String?
  description        String?
  logoUrl            String?
  /// Rubros (catálogo src/store/store-categories.ts).
  categories         String[]       @default([])
  status             MerchantStatus @default(INVITADO)
  cuitVerifiedAt     DateTime?
  cuitVerifiedByUid  String?
  cuitVerificationNote String?
  activatedAt        DateTime?
  suspendedAt        DateTime?
  suspendedReason    String?
  createdByUid       String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  members        MerchantMember[]
  invitations    MerchantInvitation[]
  paymentAccount MerchantPaymentAccount?
  products       StoreProduct[]
  orders         StoreOrder[]

  @@index([status])
}

model MerchantMember {
  id         String       @id @default(cuid())
  merchantId String
  userId     String
  role       MerchantRole @default(OPERADOR)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([userId])
}

/// Invitación de un solo uso: se guarda solo el hash del token.
model MerchantInvitation {
  id               String       @id @default(cuid())
  merchantId       String
  email            String
  role             MerchantRole @default(ADMIN_COMERCIO)
  tokenHash        String       @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdByUid     String
  createdAt        DateTime     @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

/// Cuenta de cobro del comercio, independiente del proveedor.
model MerchantPaymentAccount {
  id          String    @id @default(cuid())
  merchantId  String    @unique
  /// transfer | mercadopago | otro
  provider    String
  /// PENDING | CONNECTED | DISABLED
  status      String    @default("PENDING")
  holderName  String?
  /// Alias o identificador visible de la cuenta (nunca credenciales).
  accountLabel String?
  connectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

enum CommissionScope {
  GLOBAL
  CLUB
  MERCHANT
}

/// Regla de comisión versionada. Una versión no se edita: se reemplaza por otra.
/// platformPercent = X (lo que se descuenta al vendedor), clubPercent = Y (parte de X para el club de retiro).
model CommissionRule {
  id              String          @id @default(cuid())
  scope           CommissionScope
  clubId          String?
  merchantId      String?
  platformPercent Decimal?        @db.Decimal(5, 2)
  clubPercent     Decimal?        @db.Decimal(5, 2)
  version         Int
  validFrom       DateTime        @default(now())
  validTo         DateTime?
  reason          String?
  createdByUid    String
  createdAt       DateTime        @default(now())

  @@index([scope, clubId, merchantId])
}

/// Cómo participa un club en la tienda de la app.
model ClubStoreSettings {
  id                 String   @id @default(cuid())
  clubId             String   @unique
  companyId          String
  /// El club acepta ser punto de retiro de pedidos de comercios.
  acceptMerchants    Boolean  @default(false)
  /// Rubros que el club no acepta.
  excludedCategories String[] @default([])
  pickupHours        String?
  /// Pedidos por día como punto de retiro (null = sin límite).
  dailyCapacity      Int?
  paused             Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

/// Producto de un comercio.
model StoreProduct {
  id          String   @id @default(cuid())
  merchantId  String
  name        String
  description String?
  category    String
  price       Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items    StoreOrderItem[]

  @@index([merchantId, active])
  @@index([category])
}

enum StoreOrderStatus {
  PLACED
  CONFIRMED
  AT_CLUB
  DELIVERED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  ACCRUED
  VOID
}

/// Pedido de la tienda: un vendedor (comercio o club), retiro en un club.
/// Guarda la foto de los porcentajes vigentes al comprar.
model StoreOrder {
  id               String           @id @default(cuid())
  /// Código corto para hablar del pedido: "FX-7K2M9".
  code             String           @unique
  buyerUserId      String
  /// MERCHANT | CLUB
  sellerType       String
  merchantId       String?
  sellerClubId     String?
  pickupClubId     String
  pickupCompanyId  String
  status           StoreOrderStatus @default(PLACED)
  /// Código que muestra el comprador al retirar.
  pickupCode       String
  buyerName        String
  buyerPhone       String?
  notes            String?
  subtotal         Decimal          @db.Decimal(12, 2)
  currency         String           @default("ARS")
  /// coordinated = se paga al comercio/club (hasta que haya cobro online).
  paymentMode      String           @default("coordinated")
  // Snapshot de comisión.
  platformPercent  Decimal          @db.Decimal(5, 2)
  clubPercent      Decimal          @db.Decimal(5, 2)
  platformAmount   Decimal          @db.Decimal(12, 2)
  clubAmount       Decimal          @db.Decimal(12, 2)
  sellerAmount     Decimal          @db.Decimal(12, 2)
  commissionRules  Json?
  commissionStatus CommissionStatus @default(PENDING)
  commissionAccruedAt DateTime?
  confirmedAt      DateTime?
  receivedAtClubAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  buyer      User             @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  merchant   Merchant?        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  pickupClub Club             @relation("StoreOrderPickupClub", fields: [pickupClubId], references: [id], onDelete: Restrict)
  sellerClub Club?            @relation("StoreOrderSellerClub", fields: [sellerClubId], references: [id], onDelete: Restrict)
  items      StoreOrderItem[]

  @@index([buyerUserId, createdAt])
  @@index([merchantId, status])
  @@index([pickupClubId, status])
  @@index([sellerClubId, status])
  @@index([commissionStatus, createdAt])
}

model StoreOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String?
  clubProductId  String?
  name           String
  size           String?
  unitPrice      Decimal  @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal  @db.Decimal(12, 2)

  order       StoreOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  clubProduct ShopProduct?  @relation(fields: [clubProductId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Turno fijo semanal (el equipo de los martes a las 21). Genera un turno por fecha.
model RecurringBooking {
  id              String   @id @default(cuid())
  companyId       String
  clubId          String
  facilityId      String
  /// 0 = domingo … 6 = sábado
  weekday         Int
  startMinute     Int
  durationMinutes Int      @default(60)
  /// ALQUILER | ENTRENAMIENTO | PARTIDO | MANTENIMIENTO
  kind            String   @default("ALQUILER")
  clientName      String
  clientPhone     String?
  price           Decimal  @default(0) @db.Decimal(12, 2)
  notes           String?
  /// Vigencia (fechas locales YYYY-MM-DD); endDate null = sin fin.
  startDate       String
  endDate         String?
  createdByUid    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  facility Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([clubId, weekday])
  @@index([facilityId])
}

/// Disciplina habilitada en un club (antes clubs/{id}/available_disciplines en Firestore).
model ClubDiscipline {
  id              String   @id
  companyId       String
  clubId          String
  sportId         String
  name            String
  emoji           String?
  season          String?
  coordinatorId   String?
  coordinatorName String?
  location        String?
  gender          String?
  minAge          Int?
  maxAge          Int?
  description     String?
  status          String   @default("active")
  extra           Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, sportId])
  @@index([companyId])
}

/// Rama o categoría dentro de una disciplina (antes clubs/{id}/divisions en Firestore).
model Division {
  id            String   @id @default(cuid())
  companyId     String
  clubId        String
  sport         String?
  name          String
  branch        String?
  minAge        Int?
  maxAge        Int?
  coordinatorId String?
  headCoachId   String?
  status        String   @default("active")
  extra         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  club    Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  players Player[]

  @@index([clubId, sport])
  @@index([companyId])
}

/// Documentos que vivían en Firestore (planteles, eventos, asistencias, tablas, rivales, novedades, staff…),
/// guardados por su ruta. Etapa 2 de la salida de Firestore: misma forma, misma ruta, en Postgres.
model StoreDocument {
  id         String   @id @default(cuid())
  /// Ruta completa: "clubs/c1/divisions/d1/teams/t1" o "users/uid".
  path       String   @unique
  /// Ruta de la colección: "clubs/c1/divisions/d1/teams".
  parentPath String
  /// Nombre de la colección ("teams"), para consultas de grupo.
  collection String
  docId      String
  clubId     String?
  companyId  String?
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([parentPath])
  @@index([clubId, collection])
  @@index([collection])
}

model LeagueTournament {
  id          String    @id @default(cuid())
  leagueId    String
  companyId   String
  name        String
  /// regular | special (copas, amistosos, festivales)
  kind        String    @default("regular")
  category    String?
  format      String?
  description String?
  /// draft | active | finished
  status      String    @default("draft")
  /// league | knockout | groups | groups_knockout
  formatType  String    @default("league")
  groupCount      Int?
  advancePerGroup Int?
  thirdPlace      Boolean @default(false)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  league League                  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  clubs  LeagueTournamentClub[]
  matches Match[]

  @@index([leagueId, createdAt])
  @@index([companyId])
}

model LeagueTournamentClub {
  tournamentId String
  clubId       String
  seed         Int?
  createdAt    DateTime @default(now())

  tournament LeagueTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  club       Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([tournamentId, clubId])
  @@index([clubId])
}


/// Presentismo: planilla de asistencia a un entrenamiento de un equipo (un registro por equipo y día).
/// teamId/divisionId son ids de la estructura deportiva del club (no FK: viven en el docstore).
model AttendanceSession {
  id         String   @id @default(cuid())
  companyId  String
  clubId     String
  divisionId String?
  teamId     String
  date       DateTime @db.Date
  takenBy    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club    Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([clubId, teamId, date])
  @@index([companyId, clubId, date])
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  sessionId String
  playerId  String
  /// present | late | absent | justified
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@index([playerId])
}
