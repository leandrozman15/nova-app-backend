PORT=3001
CORS_ORIGIN=http://localhost:9002
APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CREDENTIALS_PATH=/etc/secrets/firebase-admin.json
FIRESTORE_DATABASE_ID=your-named-firestore-database-id
STAGING_FIREBASE_PROJECT_ID=your-staging-firebase-project-id
STAGING_DATABASE_HOST=your-staging-postgres-host
STAGING_FIRESTORE_DATABASE_ID=your-staging-firestore-database-id
