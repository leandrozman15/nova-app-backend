PORT=3001
CORS_ORIGIN=http://localhost:9002
APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CREDENTIALS_PATH=/etc/secrets/firebase-admin.json
FIRESTORE_DATABASE_ID=your-named-firestore-database-id
STAGING_FIREBASE_PROJECT_ID=your-staging-firebase-project-id
STAGING_DATABASE_HOST=your-staging-postgres-host
STAGING_FIRESTORE_DATABASE_ID=your-staging-firestore-database-id

# Clima (OpenWeatherMap, plan gratis: https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=

# Instagram (publicar novedades): app de Meta con el producto Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcional: id de la configuración de Facebook Login para empresas (si se usa en vez de permisos sueltos)
INSTAGRAM_CONFIG_ID=
# Facebook (publicar novedades en la página del club): configuración de Login para empresas con el activo Páginas
FACEBOOK_CONFIG_ID=

# Emails transaccionales (Resend): clave de API y remitente de un dominio verificado en Resend
RESEND_API_KEY=
EMAIL_FROM="Fluxion Sport <comercial@fluxi-on.com>"

# Secreto del cron diario que envía recordatorios de cuota y mora (POST /internal/email/reminders con el header x-cron-secret)
CRON_SECRET=

# TikTok (Login Kit + Content Posting API): credenciales de la app en developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Administradores de la plataforma Fluxion (panel /platform). Si no se setean, el código
# usa como único respaldo el UID/email de Lean (ver platform-admin.guard.ts) para nunca
# quedar afuera. En Render conviene setear estas dos para no depender del valor hardcodeado:
# PLATFORM_ADMIN_UIDS=gP2wfenUBpXxvD1BddK6YN5eivW2
# PLATFORM_ADMIN_EMAILS=leozman15@gmail.com
PLATFORM_ADMIN_UIDS=
PLATFORM_ADMIN_EMAILS=
# Exigir segundo factor (MFA/TOTP) para entrar al panel de Fluxion
PLATFORM_REQUIRE_MFA=
