PORT=3001
CORS_ORIGIN=http://localhost:9002
APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CREDENTIALS_PATH=/etc/secrets/firebase-admin.json
FIRESTORE_DATABASE_ID=your-named-firestore-database-id
STAGING_FIREBASE_PROJECT_ID=your-staging-firebase-project-id
STAGING_DATABASE_HOST=your-staging-postgres-host
STAGING_FIRESTORE_DATABASE_ID=your-staging-firestore-database-id

# Clima (OpenWeatherMap, plan gratis: https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=

# Instagram (publicar novedades): app de Meta con el producto Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcional: id de la configuración de Facebook Login para empresas (si se usa en vez de permisos sueltos)
INSTAGRAM_CONFIG_ID=
# Facebook (publicar novedades en la página del club): configuración de Login para empresas con el activo Páginas
FACEBOOK_CONFIG_ID=

# Emails transaccionales (Resend): clave de API y remitente de un dominio verificado en Resend
RESEND_API_KEY=
EMAIL_FROM="Fluxion Sport <avisos@fluxi-on.com>"
